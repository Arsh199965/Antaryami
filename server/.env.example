# Cerebras API Configuration
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL_ID=llama-3.3-70b
# CEREBRAS_TEMPERATURE=0.7
# CEREBRAS_MAX_TOKENS=4096

# Sarvam AI (Speech-to-Text)
# Get your API key from https://console.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# Soniox (Legacy - kept for reference)
# SONIOX_API_KEY=your_soniox_api_key_here

# Cartesia (Text-to-Speech)
CARTESIA_API_KEY=your_cartesia_api_key_here
# CARTESIA_TTS_ENABLED=true

# Greeting audio (played at call start for Twilio and in-app voice)
# GREETING_AUDIO_PATH=/path/to/greeting.wav

# Twilio (Phone Call Integration)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# WebSocket URL for Twilio Media Streams (use ngrok for local testing)
# Example: wss://your-subdomain.ngrok.io/twilio/media
TWILIO_WEBSOCKET_URL=wss://your-domain.com/twilio/media

# MongoDB (for persistence: users, stations, conversations, agents, intent_logs, subscriptions, handoffs, swaps)
MONGODB_URL=mongodb://localhost:27017

# Pinecone + Bedrock Titan Embeddings (for getCallInsights - same as data-ingestion pipeline)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_CALL_SCENARIOS=call_scenarios
PINECONE_INDEX_RESPONSE_PATTERNS=response_patterns
PINECONE_INDEX_POLICY_KNOWLEDGE=policy_knowledge
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v1:0